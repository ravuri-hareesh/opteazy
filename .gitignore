# OptEazy Minimal Ignore 
# (Only ignoring runtime/temp files)

# Python Environment
__pycache__/
*.pyc
*.pyo
*.pyd
env/
venv/
.venv/
pip-log.txt
.tox/
.coverage
.cache
nosetests.xml
coverage.xml
*,cover
.hypothesis/

# IDE & Editor
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Runtime/Lock files
*.lock
WiredTiger.lock
mongod.lock

# Data Directories (Tracked for Snapshot)
# (Removing input_file/ and output/ from ignore as requested)

# Persistent DB Data (Exclude raw files from Git)
db_persist/
logs/
temp/
# Note: snapshots/ is tracked for portable backups
